<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>ระบบบันทึกเสียงไมโครโฟน</title>
    <style>
        body { font-family: sans-serif; text-align: center; margin-top: 50px; }
        button { padding: 10px 20px; font-size: 16px; margin: 5px; cursor: pointer; }
        audio { display: block; margin: 20px auto; }
    </style>
</head>
<body>

    <h2>ระบบบันทึกเสียงผ่านไมโครโฟน</h2>
    
    <!-- ปุ่มควบคุมระบบอัดเสียง -->
    <button id="recordButton">เริ่มอัดเสียง</button>
    <button id="stopButton" disabled>หยุดอัดเสียง</button>
    
    <!-- ส่วนเล่นเสียงและดาวน์โหลด -->
    <audio id="audioPlayback" controls></audio>
    <br>
    <a id="downloadLink" style="display:none;">ดาวน์โหลดไฟล์เสียง</a>

    <script>
        let mediaRecorder;
        let audioChunks = [];

        const recordButton = document.getElementById("recordButton");
        const stopButton = document.getElementById("stopButton");
        const audioPlayback = document.getElementById("audioPlayback");
        const downloadLink = document.getElementById("downloadLink");

        // 1. กดปุ่ม "เริ่มอัดเสียง"
        recordButton.addEventListener("click", async () => {
            try {
                // ขอสิทธิ์ใช้ไมค์
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                // เมื่อมีข้อมูลเสียงเข้ามา ให้เก็บใส่ array
                mediaRecorder.ondataavailable = (event) => {
                    audioChunks.push(event.data);
                };

                // เมื่อกดหยุดอัด ให้รวมข้อมูลเสียงเป็นไฟล์เดียว
                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    const audioUrl = URL.createObjectURL(audioBlob);
                    
                    // แสดงเสียงที่อัดในตัวเล่นเสียง (Audio Player)
                    audioPlayback.src = audioUrl;

                    // สร้างลิงก์สำหรับดาวน์โหลดไฟล์
                    downloadLink.href = audioUrl;
                    downloadLink.download = "my-recording.webm";
                    downloadLink.style.display = "block";
                    downloadLink.textContent = "คลิกเพื่อดาวน์โหลดไฟล์เสียง";
                };

                // เริ่มต้นอัดเสียง
                mediaRecorder.start();
                recordButton.disabled = true;
                stopButton.disabled = false;
                console.log("กำลังอัดเสียง...");

            } catch (error) {
                alert("ไม่สามารถเข้าถึงไมโครโฟนได้: " + error.message);
            }
        });

        // 2. กดปุ่ม "หยุดอัดเสียง"
        stopButton.addEventListener("click", () => {
            mediaRecorder.stop();
            
            // หยุดการทำงานของฮาร์ดแวร์ไมค์
            mediaRecorder.stream.getTracks().forEach(track => track.stop());

            recordButton.disabled = false;
            stopButton.disabled = true;
            console.log("หยุดอัดเสียงแล้ว");
        });
    </script>

</body>
</html>
