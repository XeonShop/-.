<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ห้องพูดคุยนักเรียน</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="chat-container">

        <!-- หัวเว็บ -->
        <div class="chat-header">
            <div>
                <h1>💬 ห้องพูดคุยนักเรียน</h1>
                <p>ถามเรื่องงาน • การบ้าน • โค้ด • ข้อสงสัยต่าง ๆ</p>
            </div>

            <div class="online">
                🟢 ออนไลน์
            </div>
        </div>

        <!-- พื้นที่แชต -->
        <div class="chat-box" id="chatBox">

            <div class="message other">
                <div class="name">👨‍🏫 ครู</div>
                <div class="text">
                    สวัสดีนักเรียนทุกคน 👋<br>
                    หากมีข้อสงสัยเกี่ยวกับงาน สามารถถามได้เลย
                </div>
                <div class="time">18:20</div>
            </div>

            <div class="message me">
                <div class="name">👤 นักเรียน</div>
                <div class="text">
                    ครูครับ งาน HTML ต้องส่งวันไหนครับ?
                </div>
                <div class="time">18:22</div>
            </div>

        </div>

        <!-- ช่องพิมพ์ -->
        <div class="input-area">

            <input
                type="text"
                id="messageInput"
                placeholder="พิมพ์คำถามหรือข้อความ..."
            >

            <button onclick="sendMessage()">
                ➤ ส่ง
            </button>

        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>
