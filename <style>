/* ================= CHAT BUTTON ================= */

.nav-chat{
    position:relative;
    display:flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    border-radius:12px;

    color:#ffffff !important;
    text-decoration:none;

    background:linear-gradient(
        135deg,
        rgba(0,212,255,.18),
        rgba(124,58,237,.25)
    );

    border:1px solid rgba(0,212,255,.35);

    box-shadow:
        0 0 15px rgba(0,212,255,.12);

    transition:.3s;
}

.nav-chat:hover{
    transform:translateY(-2px);

    background:linear-gradient(
        135deg,
        rgba(0,212,255,.3),
        rgba(124,58,237,.4)
    );

    border-color:#00d4ff;

    box-shadow:
        0 0 25px rgba(0,212,255,.35);
}

.chat-icon{
    font-size:18px;
}

.chat-online{
    width:8px;
    height:8px;

    background:#22c55e;

    border-radius:50%;

    box-shadow:
        0 0 10px #22c55e;

    animation:chatPulse 1.5s infinite;
}

@keyframes chatPulse{

    0%,100%{
        transform:scale(1);
        opacity:1;
    }

    50%{
        transform:scale(1.4);
        opacity:.6;
    }

}
